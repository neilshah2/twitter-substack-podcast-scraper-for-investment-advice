{"$id":"https://example.com/schemas/mention.schema.json","$schema":"https://json-schema.org/draft/2020-12/schema","additionalProperties":false,"description":"One investable claim tied to a stock ticker, linked to its source.","properties":{"date":{"description":"Date of the mention, YYYY-MM-DD.","pattern":"^\\d{4}-\\d{2}-\\d{2}$","type":"string"},"episode":{"description":"Podcast episode title (only for source_type=podcast).","type":"string"},"said_by":{"description":"Author / account / speaker who made the claim.","type":"string"},"source":{"description":"Human-readable source label, e.g. list name, newsletter name, podcast name.","type":"string"},"source_type":{"enum":["x","substack","podcast"],"type":"string"},"text":{"description":"1-2 sentence investable claim.","minLength":1,"type":"string"},"ticker":{"description":"Uppercase ticker symbol, no $ prefix.","pattern":"^[A-Z]{1,5}$","type":"string"},"url":{"description":"Direct link to the source item.","format":"uri","type":"string"}},"required":["ticker","date","source_type","source","said_by","text","url"],"title":"Ticker mention","type":"object"}