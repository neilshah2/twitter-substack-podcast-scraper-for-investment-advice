# Copy these into your environment (or a .env file — never commit it).
# Every value below is a placeholder.

X_BEARER_TOKEN=your_x_api_v2_bearer_token
LLM_API_KEY=your_llm_api_key
LLM_ENDPOINT=https://api.anthropic.com/v1/messages
LLM_MODEL=claude-sonnet-4-20250514
TRANSCRIPTION_API_KEY=your_transcription_api_key
TRANSCRIPTION_ENDPOINT=https://api.openai.com/v1/audio/transcriptions
TRANSCRIPTION_MODEL=whisper-1
TTS_API_KEY=your_tts_api_key
TTS_ENDPOINT=https://api.openai.com/v1/audio/speech
TTS_MODEL=tts-1
# Voice for the spoken digest: a preset (narrator_male, narrator_female,
# narrator_neutral) from config/voices.yaml (or config/voices.example.yaml
# as fallback), or a raw provider voice id.
TTS_VOICE=alloy
# Optional: extend the built-in ticker list for extraction
TICKER_LIST=
